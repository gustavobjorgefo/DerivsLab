# Normalize line endings to LF in the repository, regardless of OS.
* text=auto eol=lf

# Explicit for source and config files that matter most for diffs.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files — never touch line endings.
*.png binary
*.jpg binary
*.pdf binary